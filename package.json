{
  "name": "caweb-divi-extension",
  "version": "1.0.0",
  "private": true,
  "repository": "https://github.com/CAWebPublishing/caweb-divi-extension",
  "author": "CAWebPublishing",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=development webpack -w --config webpack.config.js --progress",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "test": "wp-scripts test-unit-js --config ./test-config/jest.config.js",
    "zip": "gulp zip",
    "reset-install": "rm -rf ./package-lock.json ./node_modules/ && npm install",
    "reset-install:divi-4": "cd divi-4 && rm -rf ./package-lock.json ./node_modules/ && npm install",
    "install:divi-4": "cd divi-4 && npm install",
    "start:divi-4": "cd divi-4 && npm run start",
    "build:divi-4": "npm run build",
    "install:all": "npm install && npm run install:divi-4",
    "start:all": "npm run start & npm run start:divi-4",
    "build:all": "npm run build && npm run build:divi-4"
  },
  "devDependencies": {
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "babel-loader": "^9.1.2",
    "thread-loader": "^3.0.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  },
  "msw": {
    "workerDirectory": "storybook-assets"
  },
  "optionalDependencies": {
    "win-node-env": "^0.6.1"
  }
}
